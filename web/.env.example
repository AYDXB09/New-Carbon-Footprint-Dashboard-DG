# Copy to web/.env.local and fill in. .env.local is gitignored; this file is
# the only env file that is tracked, and it must only ever hold placeholders.

# Your Supabase project: Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The *publishable* (anon) key. It ships to every browser by design and is
# protected by row-level security — never put a secret / service-role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# A Mapbox *public* token (pk.…) for the profile-page map. Restrict it to your
# own URLs in the Mapbox dashboard.
VITE_MAPBOX_TOKEN=pk.xxxxxxxxxxxxxxxx
